APP_NAME=1PayRouter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite keeps local setup zero-config. Switch to MySQL for staging/production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=payrouter
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Marketing / brand configuration (config/marketing.php)
#--------------------------------------------------------------------------
# The product name is a working name — change it here to rename the whole site.
PRODUCT_NAME=1PayRouter
SUPPORT_EMAIL=support@example.com
SALES_EMAIL=sales@example.com
PUBLIC_API_BASE_URL=https://api.example.com

# Pricing. Leave unset and the UI renders "Configurable" instead of a made-up rate.
# PRICING_ORCHESTRATION_SETUP=
# PRICING_ORCHESTRATION_MONTHLY=
# PRICING_ORCHESTRATION_RATE=

# Pay-as-you-go is hidden until it is contractually available.
PRICING_PAYG_ENABLED=false
# PRICING_PAYG_RATE_FROM=
# PRICING_PAYG_NO_CHARGE_ON_FAILURE=false

# Social links render only when a real account exists. Leave blank otherwise.
# SOCIAL_GITHUB=
# SOCIAL_LINKEDIN=
# SOCIAL_X=

# Links that only render once they exist. Leave unset and the UI omits them
# rather than linking to a 404 (see config/marketing.php footer_links).
# DOCS_URL=
# DOCS_QUICKSTART_URL=
# DOCS_SDKS_URL=
# CHANGELOG_URL=
# ABOUT_URL=
# CAREERS_URL=
# BLOG_URL=
# LEGAL_PRIVACY_URL=
# LEGAL_TERMS_URL=
# LEGAL_ACCEPTABLE_USE_URL=
# LEGAL_SECURITY_URL=
# LEGAL_COMPLIANCE_URL=

# Renders the rankings page with clearly-labelled synthetic rows for design
# review. Always false in production — the page shows an empty state instead.
RANKINGS_DEMO_DATA=false
